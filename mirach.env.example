# mirach.env — local configuration for the Mirach voice assistant.
# Copy to mirach.env (same directory) and uncomment lines you want to change.
# Format: KEY=value  (plain shell syntax; no export, no quotes needed for simple values)
#
# Precedence (highest → lowest):
#   1. Variables already exported in the shell or set via systemd Environment=
#   2. This file (mirach.env)
#   3. Built-in defaults in mirach/config.py
#
# After editing, restart the daemon:
#   systemctl --user restart mirach
#
# NOTE: MIRACH_BASE_DIR is NOT configured here. It is resolved by run_daemon.sh
# (self-locate from script path) and pinned in the systemd unit via Environment=.
# Only override it via the shell or the unit, never in this file.

# ── Locale & hotkey ──────────────────────────────────────────────────────────
# Locale of spoken fillers and desktop notifications. Built-in: en, es.
# Add more locales in mirach/i18n.py.
#MIRACH_LOCALE=en

# Hotkey label shown in notifications (cosmetic only — the actual key binding
# lives in your compositor config and is wired up by install.py).
#MIRACH_HOTKEY=Alt+Z

# ── Microphone ───────────────────────────────────────────────────────────────
# Case-insensitive substring match against your mic's device name.
# Leave empty (or commented) to use the system default input device.
# List available devices:
#   ./venv/bin/python -c "import sounddevice as sd; print(sd.query_devices())"
#MIRACH_MIC=

# Native mic sample rate (Hz). Most USB mics: 48000; some are 44100.
#MIRACH_SAMPLE_RATE=48000

# ── STT (Whisper) ────────────────────────────────────────────────────────────
# Language you speak into the mic (ISO 639-1 code, e.g. en, es, fr).
#MIRACH_WHISPER_LANG=en

# Whisper model name. "medium" = multilingual; "medium.en" = English-only (faster).
#MIRACH_WHISPER_MODEL=medium

# Inference device: cuda (NVIDIA GPU, ~0.5 s) or cpu (~2-5 s).
#MIRACH_WHISPER_DEVICE=cuda

# Compute type: float16 (GPU, higher quality) or int8 (CPU, or mixed GPU).
#MIRACH_WHISPER_COMPUTE=int8

# Beam size 1-5 (lower = faster decoding, higher = marginally more accurate).
#MIRACH_WHISPER_BEAM_SIZE=3

# ── TTS (Piper) ──────────────────────────────────────────────────────────────
# Voice model filename inside voices/. Download with the installer or manually.
# See: https://huggingface.co/rhasspy/piper-voices
#MIRACH_VOICE=en_US-lessac-low.onnx

# Playback speed factor. >1 = slower; <1 = faster. Piper default is 1.0.
#MIRACH_VOICE_SPEED=1.2

# ── Backend ──────────────────────────────────────────────────────────────────
# LLM backend: opencode_serve (default, delegates to `opencode serve`) or
# native (local Ollama-compatible endpoint via the built-in agentic harness).
#MIRACH_BACKEND=opencode_serve

# opencode_serve: override the provider and model used by opencode.
# Leave empty to use the provider/model configured in opencode's own config.
#MIRACH_OPENCODE_SERVE_PROVIDER_ID=
#MIRACH_OPENCODE_SERVE_MODEL_ID=

# native: Ollama-compatible base URL and model name.
#MIRACH_NATIVE_BASE_URL=http://localhost:11434
#MIRACH_NATIVE_MODEL=qwen3:14b
# Tool-calling protocol: auto | native | prompted
#MIRACH_NATIVE_TOOL_PROTOCOL=auto

# ── Web search region ────────────────────────────────────────────────────────
# DuckDuckGo region code for web_search (wt-wt = worldwide).
# Examples: us-en, es-es, mx-es, uk-en
#MIRACH_SEARCH_REGION=wt-wt

# ── Filler phrases ───────────────────────────────────────────────────────────
# Seconds of silence before the first filler phrase is spoken during long responses.
#MIRACH_FILLER_DELAY=6.0

# Pipe-separated override list (replaces the locale-specific list entirely).
#MIRACH_FILLERS=Just a moment.|Let me think.|Hmm.

# ── Session ──────────────────────────────────────────────────────────────────
# Seconds of inactivity before a fresh LLM session is started automatically.
#MIRACH_SESSION_IDLE_TIMEOUT=3600

# ── Visibility server (HTTP/SSE) ─────────────────────────────────────────────
# The local API/SSE server powers the web widget and the mobile app.
# Set MIRACH_SERVER_ENABLED=0 to disable it entirely.
#MIRACH_SERVER_ENABLED=1
#MIRACH_SERVER_HOST=127.0.0.1
#MIRACH_SERVER_PORT=7270

# ── Obsidian vault (persistent memory) ───────────────────────────────────────
# Absolute path to your Obsidian vault. Mirach writes notes here for long-term memory.
#MIRACH_OBSIDIAN_VAULT=~/ObsidianVault

# ── Advanced ─────────────────────────────────────────────────────────────────
# Context compaction strategy when the conversation history grows long.
# Options: none (off, default) | sliding (drop oldest rounds) | summarize (LLM prefix)
#MIRACH_CONTEXT_STRATEGY=none
#MIRACH_CONTEXT_MAX_TOKENS=32768

# Path to policy.yaml (tool-permission rules). Defaults to <BASE_DIR>/policy.yaml.
#MIRACH_NATIVE_POLICY=

# Unix socket path (for trigger.py → daemon communication).
#MIRACH_SOCKET=/tmp/mirach.sock
