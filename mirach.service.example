# Example systemd user service for Mirach.
# Install: copy to ~/.config/systemd/user/mirach.service, then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now mirach
#
# Stop / restart / status:
#   systemctl --user stop mirach
#   systemctl --user restart mirach
#   systemctl --user status mirach

[Unit]
Description=Mirach voice assistant
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/mirach/run_daemon.sh
Restart=on-failure
RestartSec=3

# Inherit Wayland / audio / dbus from the graphical session
PassEnvironment=WAYLAND_DISPLAY XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS

# Project location — install.py rewrites this to the actual repo path.
# run_daemon.sh self-locates too, so this is belt-and-suspenders.
# Environment=MIRACH_BASE_DIR=%h/mirach

# User-tunable config lives in mirach.env (same directory as the repo).
# install.py rewrites the path below to the actual repo location.
# The leading '-' means systemd silently ignores the file if it doesn't exist.
EnvironmentFile=-%h/mirach/mirach.env

[Install]
WantedBy=graphical-session.target
